{
  "expo": {
    "name": "BaraBara",
    "slug": "barabara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot/icon.png",
    "scheme": "barabara",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mascot/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "favicon": "./assets/mascot/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BaraBara to access your photos to upload classwork pages.",
          "cameraPermission": "Allow BaraBara to use the camera to photograph your classwork."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
