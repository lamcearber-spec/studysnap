# MarmotMakesMath — environment template
# Copy to .env.development for local dev. NEVER commit .env or .env.* (covered by .gitignore).

# === Azure OpenAI (Sweden Central) — vision + structured output ===
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# === Black Forest Labs EU — flux-dev for occasional hero scenes ===
BFL_API_KEY=
BFL_BASE_URL=https://api.eu.bfl.ai

# === Postgres on Hermes (Tailscale-only) ===
DATABASE_URL=postgres://marmot:<password>@100.94.144.128:5444/marmot

# === Storage on Hermes (nginx static-served) ===
STORAGE_PATH=/var/www/marmot/storage
STORAGE_PUBLIC_URL=https://images.marmotmakesmath.app

# === RevenueCat — in-app subscriptions ===
REVENUECAT_WEBHOOK_SECRET=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
